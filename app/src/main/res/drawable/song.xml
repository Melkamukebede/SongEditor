<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#4DB6AC"
                android:centerColor="#4DB6AC"
                android:endColor="#4DB6AC"
                android:centerX="0.25"
                android:centerY="0.75" />
            <corners android:radius="1dp" />
            <stroke
                android:width="1dp"
                android:color="#2D3436" />
        </shape>
    </item>
    
    
    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#4DB6AC"
                android:dashWidth="2dp"
                android:dashGap="4dp" />
        </shape>
    </item>

</layer-list>